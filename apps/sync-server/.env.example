# LifeHub 同步服务 —— 环境变量示例
#
# 用法（docker compose 会自动读取**同目录**下的 .env）：
#   cp apps/sync-server/.env.example .env   然后把下面的令牌换成你自己生成的
#
# ⚠️ .env 含真实令牌，**绝不要**把它提交到仓库。
#
# 生成一个设备令牌（每台设备一个，不要复用）：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# ── 必填：设备令牌 ────────────────────────────────────────────────
# 逗号分隔，支持「标签=令牌」写法（标签只用于日志识别，不参与鉴权）。
# 例：phone=<tokenA>,laptop=<tokenB>
LIFEHUB_SYNC_TOKENS=

# ── 可选：监听与存储 ──────────────────────────────────────────────
# 容器内必须用 0.0.0.0，否则端口映射不通。
LIFEHUB_SYNC_HOST=127.0.0.1
LIFEHUB_SYNC_PORT=8787
LIFEHUB_SYNC_DB_PATH=/data/lifehub-sync.db

# ── 可选：快照保留份数（docker-compose 的 snapshot 服务使用）─────
LIFEHUB_SYNC_SNAPSHOT_KEEP=7
