{
  "name": "@lifehub/core",
  "version": "0.1.0",
  "private": true,
  "description": "LifeHub 核心领域层：零 DOM 依赖的纯 TypeScript 领域逻辑（模型 / 金额 / 时间 / 加密 / CSV / 规则 / 存储抽象）",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/crypto/providers/node-crypto-provider.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest run --config vitest.config.ts --reporter=verbose tests/performance"
  },
  "dependencies": {
    "@noble/ciphers": "1.2.1",
    "@noble/hashes": "1.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
